# ── Database ────────────────────────────────────────────────────────────
# With docker compose, only POSTGRES_PASSWORD is needed (DATABASE_URL is
# built for you). For a non-Docker install, set DATABASE_URL instead.
POSTGRES_PASSWORD="change-me-to-a-long-random-string"
DATABASE_URL="postgresql://evaluator:change-me@localhost:5432/evaluator"

# ── First admin account ─────────────────────────────────────────────────
# Created automatically on the first sign-in attempt while no admin exists.
# Sign in with these, then change the password under Account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-on-first-login"
ADMIN_NAME="Administrator"

# ── AI scoring (optional) ───────────────────────────────────────────────
# Easiest: leave this empty and add the key in the app under Settings
# (admins only). A key saved there wins over this one. Without any key the
# app still works: photos go to the admin review queue for manual scoring.
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"

# ── Server ──────────────────────────────────────────────────────────────
# Port published by docker compose.
APP_PORT=3000
# Public URL. When it starts with https://, sign-in cookies are marked Secure.
APP_URL="http://localhost:3000"
# Force Secure cookies on/off (default: auto-detect from APP_URL / proxy headers).
# COOKIE_SECURE="true"
# Where photos are stored (the Docker image uses /data/uploads).
# UPLOAD_DIR="./data/uploads"
# Time zone for greetings and dates.
TZ="Asia/Bahrain"

# Behind a corporate proxy? Set HTTPS_PROXY. The Docker image already sets
# NODE_USE_ENV_PROXY=1; without Docker, set it too (Node 22.21+).
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY="http://proxy.example.com:8080"
