generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct connection; Neon's pooled URL can't hold the
  // advisory lock `prisma migrate deploy` takes.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  FIELD_REP
  REVIEWER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  SCORED
  REVIEWED
  FLAGGED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(FIELD_REP)
  createdAt DateTime @default(now())

  submissions      Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")
}

// The Visibility Matrix itself — editable in-product by the Strategy &
// Data Analytics team under /admin/matrix. `key` is what AI detections and
// stored submission counts key off of, so renaming it effectively starts a
// new element (old submissions keep their originally-scored breakdown).
model MatrixElement {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  description   String
  pointsPerUnit Float
  maxUnits      Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
}

model Shop {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  region    String?
  city      String?
  address   String?
  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id            String           @id @default(cuid())
  shop          Shop             @relation(fields: [shopId], references: [id])
  shopId        String
  submittedBy   User?            @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById String?

  imagePath     String
  latitude      Float?
  longitude     Float?
  locationLabel String?
  capturedAt    DateTime         @default(now())

  status        SubmissionStatus @default(PENDING)
  aiSummary     String?
  aiConfidence  String?

  reviewedBy    User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewNotes   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brandScores   BrandScore[]

  @@index([shopId])
  @@index([status])
}

// One operator's visibility in one audited photo. A reseller shop carries
// several operators' branding at once, so each photo yields one row per
// operator found, each scored independently out of the full matrix.
model BrandScore {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  brand        String

  // What the AI counted. Null when a reviewer added a brand the AI missed.
  aiCounts     Json?
  aiScore      Float?
  reasoning    Json?

  // What the score is based on. Equals the AI's counts until a reviewer corrects them.
  finalCounts  Json
  finalScore   Float

  @@unique([submissionId, brand])
  @@index([brand])
}
