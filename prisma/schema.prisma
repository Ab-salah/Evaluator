generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FIELD_REP
  REVIEWER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  SCORED
  REVIEWED
  FLAGGED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(FIELD_REP)
  createdAt DateTime @default(now())

  submissions      Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")
}

// The Visibility Matrix itself — editable in-product by the Strategy &
// Data Analytics team under /admin/matrix. `key` is what AI detections and
// stored submission counts key off of, so renaming it effectively starts a
// new element (old submissions keep their originally-scored breakdown).
model MatrixElement {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  description   String
  pointsPerUnit Float
  maxUnits      Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
}

model Shop {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  region    String?
  city      String?
  address   String?
  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id            String           @id @default(cuid())
  shop          Shop             @relation(fields: [shopId], references: [id])
  shopId        String
  submittedBy   User?            @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById String?

  // Which brand this submission is scored FOR. Indirect-channel shops carry
  // several competing brands at once, so a score is only meaningful next to
  // the brand it was measured for.
  brand         String

  imagePath     String
  latitude      Float?
  longitude     Float?
  locationLabel String?
  capturedAt    DateTime         @default(now())

  status        SubmissionStatus @default(PENDING)

  // Raw AI output: per-element detected counts, reasoning, confidence.
  aiElements    Json?
  aiScore       Float?
  aiSummary     String?

  // Final, human-facing score. Equals aiScore until a reviewer overrides it.
  finalElements Json?
  finalScore    Float?

  // Other brands' visibility detected in the same photo, scored on the same
  // matrix. Powers share-of-visibility without a second API call.
  competitors   Json?

  reviewedBy    User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewNotes   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId])
  @@index([status])
  @@index([finalScore])
}
